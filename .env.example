#--------------------------------------------------------------------
# Example Environment Configuration file
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# MAINTENANCE MODE
#--------------------------------------------------------------------
# Set to true to block every application route with the maintenance page.
app.maintenanceEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_username
database.default.password = your_password
database.default.DBDriver = MySQLi
database.default.port = 3307

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
encryption.key = your_encryption_key_here

#--------------------------------------------------------------------
# BREVO EMAIL SERVICE
#--------------------------------------------------------------------
brevo.apiKey = your_brevo_api_key_here
brevo.fromEmail = your-email@example.com
brevo.fromName = Your App Name
# Transactional SMS reuses brevo.apiKey; no separate SMS key is required.
# Alphanumeric transactional SMS sender (max. 11 characters).
brevo.smsSender = JamJamie

# Optional global CC applied to every transactional email sent through
# BrevoEmailService. Comma-separated list. Leave empty (or unset) to keep the
# current behaviour with no CC. Invalid addresses here are discarded silently.
# email.defaultCc = ops@example.com, records@example.com
email.defaultCc =

# Synchronize reservation customers with Brevo list 25
brevo.contacts.enabled = false
brevo.contacts.listId = 25
brevo.contacts.timeout = 5
# Optional when PHP has no curl.cainfo/openssl.cafile configured. This CA
# bundle is shared by transactional email, SMS and contact synchronization:
# brevo.contacts.caBundle = C:\absolute\path\to\cacert.pem

# Automated-email audience: every recipient of the abandoned-cart follow-up is
# also synced to this separate Brevo list (independent on/off + list id).
# Reuses brevo.apiKey / brevo.contacts.timeout / brevo.contacts.caBundle.
brevo.contacts.followUpEnabled = false
brevo.contacts.followUpListId = 58

#--------------------------------------------------------------------
# FRONTEND URL (for email links)
#--------------------------------------------------------------------
# Development: http://localhost:3000/build
# Production: https://yourdomain.com
app.frontendURL = http://localhost:3000/build

#--------------------------------------------------------------------
# MARKETING CONVERSION TRACKING
#--------------------------------------------------------------------
# Tracking is only loaded when both this flag is true and the current host
# exactly matches marketing.allowedHost. Pixel identifiers are public values.
marketing.enabled = false
marketing.allowedHost = bookingjamwithjamie.cloud
marketing.googleTagId = G-21YKQ095DE
marketing.googleReservationSendTo = AW-16638861441/PIEACP_dgswaEIHBg_49
marketing.googlePaymentSendTo = AW-16638861441/6A9FCLX3zqIdEIHBg_49
marketing.metaPixelId = 1561789281445692
marketing.openAiPixelId = 8xFMwkD25wzWuqjVBxHzXn

#--------------------------------------------------------------------
# PRODUCTION EXAMPLE:
#--------------------------------------------------------------------
# CI_ENVIRONMENT = production
# app.frontendURL = https://jamwithjamie.com
# (or if frontend is on subdomain)
# app.frontendURL = https://app.jamwithjamie.com

#--------------------------------------------------------------------
# STRIPE
#--------------------------------------------------------------------
stripe.secretKey = 
stripe.publishableKey = 
stripe.webhookSecret = 
stripe.currency = usd
